{
  "kind": "tabledossier.config",
  "config_version": "1.0",
  "tables": [
    "demo.analytics.customers",
    "demo.analytics.orders",
    "demo.analytics.order_events",
    "demo.analytics.returns"
  ],
  "analysis_level": "standard",
  "output_dir": "/Volumes/demo/analytics/results/tabledossier",
  "purpose": "Synthetic demo on Databricks: document the demo analytics tables.",
  "value_policy": {
    "persist_examples": true,
    "example_columns": [
      {
        "table": "demo.analytics.customers",
        "column": "segment"
      }
    ]
  },
  "table_options": {
    "demo.analytics.customers": {
      "checks": [
        {
          "id": "customers_email_nulls",
          "type": "max_null_ratio",
          "column": "email",
          "max": 0.1
        }
      ]
    },
    "demo.analytics.orders": {
      "purpose": "Orders placed since 2025-01-01 (synthetic).",
      "filters": [
        {
          "column": "order_ts",
          "operator": "ge",
          "value": "2025-01-01T00:00:00Z",
          "value_type": "timestamp"
        }
      ],
      "checks": [
        {
          "id": "orders_min_rows",
          "type": "min_row_count",
          "min": 1
        },
        {
          "id": "orders_customer_not_null",
          "type": "max_null_ratio",
          "column": "customer_id",
          "max": 0.0
        },
        {
          "id": "orders_amount_range",
          "type": "value_range",
          "column": "amount",
          "min": 0,
          "max": 10000,
          "description": "Synthetic business bound; the demo data contains one planted outlier."
        }
      ]
    },
    "demo.analytics.returns": {
      "checks": [
        {
          "id": "returns_reason_nulls",
          "type": "max_null_ratio",
          "column": "reason",
          "max": 0.1
        }
      ]
    }
  },
  "deep": {
    "uniqueness": {
      "keys": [
        {
          "table": "demo.analytics.customers",
          "columns": [
            "customer_id"
          ],
          "id": "customers_key"
        },
        {
          "table": "demo.analytics.orders",
          "columns": [
            "order_id"
          ],
          "id": "orders_key"
        },
        {
          "table": "demo.analytics.order_events",
          "columns": [
            "event_id"
          ],
          "id": "events_key"
        },
        {
          "table": "demo.analytics.order_events",
          "columns": [
            "order_id",
            "event_type"
          ],
          "id": "events_per_order_and_type"
        }
      ],
      "declared_keys": true,
      "identifier_candidates": true
    }
  },
  "relationships": [
    {
      "id": "orders_customer",
      "from": {
        "table": "demo.analytics.orders",
        "columns": [
          "customer_id"
        ]
      },
      "to": {
        "table": "demo.analytics.customers",
        "columns": [
          "customer_id"
        ]
      },
      "cardinality": {
        "from": "zero_or_more",
        "to": "exactly_one"
      },
      "description": "Each order references one customer (stated by the demo author)."
    },
    {
      "id": "events_order",
      "from": {
        "table": "demo.analytics.order_events",
        "columns": [
          "order_id"
        ]
      },
      "to": {
        "table": "demo.analytics.orders",
        "columns": [
          "order_id"
        ]
      },
      "description": "Events reference orders; cardinality intentionally not asserted."
    }
  ]
}
